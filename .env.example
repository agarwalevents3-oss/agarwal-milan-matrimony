# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC — these are shipped to the browser. Safe by design; the database is
# protected by Row Level Security, not by hiding this key.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon / publishable key>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# How a member's Supabase Auth identity is derived from their mobile number.
# Public despite the name — it is a config fact (which shape an account's
# identity takes), not a credential. The browser's login form needs to agree
# with the server on this, which is the whole reason it is NEXT_PUBLIC_.
#
# "phone" needs the Supabase Phone provider enabled, which itself needs a
# configured SMS provider (Twilio, etc.) before the dashboard will save the
# toggle — even though our OTP service, not Supabase, verifies the number.
# "synthetic-email" needs no dashboard configuration at all. See docs/DECISIONS.md.
NEXT_PUBLIC_AUTH_IDENTITY_STRATEGY="synthetic-email"   # phone | synthetic-email

# ─────────────────────────────────────────────────────────────────────────────
# SECRET — server only. Never prefix any of these with NEXT_PUBLIC_.
# `npm run verify:no-secrets` fails the build if one reaches the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Bypasses ALL Row Level Security. Treat as root credentials for the database.
SUPABASE_SERVICE_ROLE_KEY="<service_role key>"

# Signs the short-lived ticket proving a phone number was OTP-verified.
# Generate with: openssl rand -base64 48
REGISTRATION_TICKET_SECRET=""

# Peppers the stored OTP hashes. Generate with: openssl rand -base64 48
OTP_HASH_SECRET=""

# Authorises the nightly retention sweep. Generate with: openssl rand -base64 32
CRON_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# INTEGRATION MODE — "mock" until the real providers are wired up.
# ─────────────────────────────────────────────────────────────────────────────
OTP_MODE="mock"          # mock | msg91 | twilio
PAYMENT_MODE="mock"      # mock | razorpay

# Fixed code accepted in mock mode. Development only; ignored unless OTP_MODE=mock.
MOCK_OTP_CODE="123456"

# ─────────────────────────────────────────────────────────────────────────────
# DEFERRED — leave blank until you activate the integration.
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# ONE-TIME ADMIN BOOTSTRAP — used by `npm run seed:admin`, then rotate.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_SEED_PHONE=""      # E.164, e.g. +919876543210
ADMIN_SEED_PASSWORD=""
